# Copy to .env.development (or .env.local) and change what you need.
# Only VITE_ values reach the browser. Never put the private owner address or any secret here.

# Mock API (MSW). Dev default: on. A build includes the mocks only when this is "on".
VITE_MOCKS=on

# Demo clock. "on" starts the clock at the moment of the designs (3 Oct 2026, 9:42 PM counter,
# 10:30 PM owner) and lets it tick. "off" uses the real time. ?now=<ISO time> always wins.
# Production builds must set this to "off".
VITE_DEMO_CLOCK=on
